{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["DOM", "DOM.Iterable", "ES2020"],
		"strict": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"noEmit": true,
		"inlineSourceMap": true,
		"inlineSources": true
	},
	"include": ["src/**/*.ts"]
}
