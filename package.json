{
	"name": "atlas",
	"version": "0.1.0",
	"description": "Obsidian plugin that imports Wikipedia articles into your vault as linked notes.",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit --skipLibCheck && tsc --noEmit --skipLibCheck -p tsconfig.tools.json",
		"test": "node scripts/test.mjs",
		"dump-import": "node scripts/dump-import.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"wikipedia"
	],
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/turndown": "^5.0.5",
		"esbuild": "^0.28.2",
		"jsdom": "^24.1.3",
		"monkey-around": "^3.0.0",
		"obsidian": "^1.14.4",
		"turndown": "^7.2.0",
		"turndown-plugin-gfm": "^1.0.2",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"mathml-to-latex": "^1.8.0"
	}
}
